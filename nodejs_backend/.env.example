# Example environment variables for nodejs_backend

# PUBLIC_INTERFACE
# Environment mode
NODE_ENV=development

# PUBLIC_INTERFACE
# Port for backend server
BACKEND_PORT=7006

# PUBLIC_INTERFACE
# CORS allowed origin for frontend app
FRONTEND_URL=http://localhost:3000

# PUBLIC_INTERFACE
# Secret for signing JWTs (use a strong random string in production)
JWT_SECRET=please-change-me

# Optional server settings
NG_APP_TRUST_PROXY=false
NG_APP_LOG_LEVEL=dev
NG_APP_HEALTHCHECK_PATH=/healthz

# PUBLIC_INTERFACE
# Basic rate limiter configuration
# RATE_LIMIT_POINTS: max requests per window per IP
# RATE_LIMIT_DURATION: window in seconds
RATE_LIMIT_POINTS=200
RATE_LIMIT_DURATION=60
