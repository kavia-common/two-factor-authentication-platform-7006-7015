# Angular Frontend Environment Example

# If left empty, Angular will use relative paths and the dev proxy (proxy.conf.json) will forward /auth/* to the backend.
NG_APP_API_BASE=

# Frontend origin (useful for documentation/backends referencing it)
NG_APP_FRONTEND_URL=http://localhost:3000

# Optional flags used elsewhere in docs/templates (not required for this demo)
NG_APP_NODE_ENV=development
NG_APP_NEXT_TELEMETRY_DISABLED=1
NG_APP_ENABLE_SOURCE_MAPS=true
NG_APP_PORT=3000
NG_APP_TRUST_PROXY=false
NG_APP_LOG_LEVEL=dev
NG_APP_HEALTHCHECK_PATH=/healthz
NG_APP_FEATURE_FLAGS=
NG_APP_EXPERIMENTS_ENABLED=false
